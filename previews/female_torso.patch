   ctx.beginPath();
   for (const sd of [1, -1]) {
-    ctx.moveTo(nx + px * sd * 5 * s, ny + py * sd * 5 * s + 3 * s);
-    ctx.quadraticCurveTo(cx + px * sd * 6 * s, cy + py * sd * 6 * s, mx + px * sd * 3 * s, my + py * sd * 3 * s);
-    ctx.quadraticCurveTo(hx + px * sd * 9 * s, hy + py * sd * 9 * s, hx + px * sd * 6 * s, hy + py * sd * 6 * s + 6 * s);
+    if (v === 'waist') {
+      // only the lower torso: a short curve in to the waist and out round the hip
+      const sx = hx + dx * 0.62, sy = hy + dy * 0.62;
+      ctx.moveTo(sx + px * sd * 5.5 * s, sy + py * sd * 5.5 * s);
+      ctx.quadraticCurveTo(mx + px * sd * 2.5 * s, my + py * sd * 2.5 * s, hx + px * sd * 8 * s, hy + py * sd * 8 * s + 2 * s);
+      ctx.quadraticCurveTo(hx + px * sd * 9 * s, hy + py * sd * 9 * s + 5 * s, hx + px * sd * 6 * s, hy + py * sd * 6 * s + 8 * s);
